# Copie para .env e ajuste. Nunca versione o .env.

# dev = usa SQLite local e aceita a chave de exemplo. prod = exige chave forte e cookies Secure.
ERP_AMBIENTE=dev

# Banco. Local: SQLite. Produção: o Postgres (Neon). As tabelas do ERP começam com erp_,
# então podem conviver com as tabelas da API pública no mesmo banco.
ERP_DATABASE_URL=sqlite:///./erp.db

# Chave que assina o cookie de sessão. Gere uma com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ERP_SECRET_KEY=chave-de-desenvolvimento-nao-use-em-producao

# Horas até o login expirar.
ERP_SESSAO_HORAS=12

# API pública que alimenta o site. O ERP lê e grava eventos e Linktree por ela (mesmas rotas do painel admin).
# Número que recebe as mensagens dos botões Reservar do site (só dígitos, com 55).
ERP_WHATSAPP_NUMERO=5516988332631
ERP_API_PUBLICA=https://fast-api-anderson.vercel.app/api/v1
ERP_EVENTOS_CACHE_SEGUNDOS=60
